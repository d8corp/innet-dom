  "jsnext:main": "index.mjs",
  "types": "index.d.ts",
  "private": true,
  "scripts": {
    "build": "innetjs release -tc -lc -e",
    "build:docs": "INNETJS_PACKAGE_VERSION=${npm_package_version} innetjs build -i docs/index -e -tc -lc",
    "start": "INNETJS_PACKAGE_VERSION=${npm_package_version} innetjs start -i docs/index -e -tc -lc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "release": "innetjs release -p",
    "patch": "innetjs patch",
    "minor": "innetjs minor",
    "major": "innetjs major"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/d8corp/innet-dom.git"
  },
  "keywords": [
